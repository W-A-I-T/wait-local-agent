# WAIT Local Agent configuration reference.
# Copy this file to `.env`, then fill in only the values you need.
# Leave secret values blank here.

# SQLite state file for the local appliance or host-side CLI.
WAIT_DATA_PATH=.wait-local-agent/state.db

# Root directory allowed for knowledge ingest paths.
WAIT_ALLOWED_DOC_ROOT=examples/sample_docs

# Legacy admin-equivalent bearer token.
WAIT_API_TOKEN=

# Preferred role-scoped bearer tokens.
WAIT_ADMIN_TOKEN=
WAIT_TECH_TOKEN=
WAIT_VIEWER_TOKEN=
WAIT_END_USER_TOKEN=
WAIT_END_USER_CLIENT_ID=
WAIT_END_USER_USER_ID=
WAIT_END_USER_SUPPORT_ENABLED=false
WAIT_END_USER_BRAND_NAME=WAIT Support
WAIT_END_USER_BRAND_TAGLINE=Private help desk
WAIT_END_USER_BRAND_LOGO_DATA_URI=
WAIT_END_USER_BRAND_ACCENT_COLOR=#1f6f55
WAIT_END_USER_BRAND_SURFACE_COLOR=#f3f5f2

# Local demo mode bypasses bearer auth when enabled.
WAIT_DEMO_MODE=true

# Secret backend: `env` or `fernet`.
WAIT_SECRETS_BACKEND=env

# Fernet vault directory used for stored secrets and encrypted backup keys.
WAIT_VAULT_PATH=.wait-local-agent/vault

# Enables live connector write execution after approval.
WAIT_ALLOW_WRITE_ACTIONS=false

# Enables outbound HTTP calls for PSA and documentation connectors.
WAIT_ALLOW_HTTP_PROBING=false

# Approval-gated communication delivery. Leave blank for preview-only mode.
WAIT_COMMUNICATION_EMAIL_HOST=
WAIT_COMMUNICATION_EMAIL_PORT=587
WAIT_COMMUNICATION_EMAIL_USERNAME=
WAIT_COMMUNICATION_EMAIL_PASSWORD=
WAIT_COMMUNICATION_EMAIL_FROM=
WAIT_COMMUNICATION_EMAIL_TLS=true
WAIT_COMMUNICATION_TEAMS_WEBHOOK_URL=
WAIT_COMMUNICATION_SLACK_WEBHOOK_URL=
WAIT_COMMUNICATION_SMS_WEBHOOK_URL=
WAIT_COMMUNICATION_SMS_AUTH_TOKEN=

# Enables provider-level cloud fallbacks when supported.
WAIT_ALLOW_CLOUD_FALLBACK=false

# Denies all remote model calls, even when cloud fallback is configured.
WAIT_OFFLINE_MODE=false

# Remote model fallback is disabled unless both model flags above are true and all four
# values below are configured. The base URL and model must match the provider's
# documented API; WAIT does not invent provider endpoints or model names.
WAIT_REMOTE_MODEL_PROVIDER=
WAIT_REMOTE_MODEL_BASE_URL=
WAIT_REMOTE_MODEL_NAME=
WAIT_REMOTE_MODEL_API_KEY=
WAIT_REMOTE_MODEL_TIMEOUT_SECONDS=20
# Optional operator-supplied rates. WAIT never guesses provider pricing.
WAIT_MODEL_INPUT_COST_USD_PER_MILLION_TOKENS=
WAIT_MODEL_OUTPUT_COST_USD_PER_MILLION_TOKENS=

# Enables local LLM inference through the configured provider endpoint.
WAIT_ALLOW_LLM_INFERENCE=false

# Chat-completions provider used for optional local inference.
WAIT_LOCAL_MODEL_PROVIDER=deterministic

# Base URL for the OpenAI-compatible local model endpoint.
WAIT_LOCAL_MODEL_BASE_URL=http://127.0.0.1:11434/v1

# Model name passed to the local model provider.
WAIT_LOCAL_MODEL_NAME=llama3.1

# Timeout, in seconds, for local model requests.
WAIT_LOCAL_MODEL_TIMEOUT_SECONDS=20

# Search backend: `sqlite` or `qdrant`.
WAIT_VECTOR_BACKEND=sqlite

# Knowledge parser mode.
WAIT_DOCUMENT_PARSER=basic

# Enables OCR when the optional parser stack is installed.
WAIT_ALLOW_OCR=false

# Embedding provider used by the vector backend.
WAIT_EMBEDDING_PROVIDER=none

# Embedding model name for vector indexing.
WAIT_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Local embedded Qdrant path when using the qdrant backend.
WAIT_QDRANT_PATH=.wait-local-agent/qdrant

# Remote Qdrant URL when using an external Qdrant service.
WAIT_QDRANT_URL=

# Qdrant collection name.
WAIT_QDRANT_COLLECTION=wait_knowledge_chunks

# Timeout, in seconds, for connector HTTP operations.
WAIT_CONNECTOR_TIMEOUT_SECONDS=20

# Enables the APScheduler-backed scheduled workflow runner.
WAIT_SCHEDULER_ENABLED=true

# Enables FastAPI rate limiting.
WAIT_RATE_LIMIT_ENABLED=true

# Default per-route rate limit.
WAIT_RATE_LIMIT_GENERAL=100/minute

# Tighter limit for connector and approval-execution routes.
WAIT_RATE_LIMIT_CONNECTOR=10/minute

# Signed update metadata URL. Empty disables update checks.
WAIT_UPDATE_CHANNEL_URL=

# Comma-separated unpadded base64url Ed25519 public keys for update verification.
WAIT_UPDATE_PUBKEYS=

# HaloPSA base URL.
WAIT_HALOPSA_BASE_URL=

# HaloPSA OAuth client id.
WAIT_HALOPSA_CLIENT_ID=

# HaloPSA OAuth client secret.
WAIT_HALOPSA_CLIENT_SECRET=

# HaloPSA tenant identifier.
WAIT_HALOPSA_TENANT=

# Optional explicit HaloPSA token endpoint.
WAIT_HALOPSA_TOKEN_URL=

# HaloPSA ticket write endpoint name.
WAIT_HALOPSA_TICKET_WRITE_ENDPOINT=Ticket

# HaloPSA action write endpoint name.
WAIT_HALOPSA_ACTION_WRITE_ENDPOINT=Actions

# Hudu base URL.
WAIT_HUDU_BASE_URL=

# Hudu API key.
WAIT_HUDU_API_KEY=

# Default Hudu page size for list calls.
WAIT_HUDU_PAGE_SIZE=25

# ConnectWise PSA server or API base URL.
WAIT_CONNECTWISE_BASE_URL=

# ConnectWise PSA company identifier and API keys.
WAIT_CONNECTWISE_COMPANY=
WAIT_CONNECTWISE_PUBLIC_KEY=
WAIT_CONNECTWISE_PRIVATE_KEY=

# ConnectWise developer application client id.
WAIT_CONNECTWISE_CLIENT_ID=

# ConnectWise API media type version and default page size.
WAIT_CONNECTWISE_API_VERSION=2022.1
WAIT_CONNECTWISE_PAGE_SIZE=25

# Syncro PSA base URL and bearer API token.
WAIT_SYNCRO_BASE_URL=
WAIT_SYNCRO_API_TOKEN=

# IT Glue documentation base URL, API key, and bounded default page size.
WAIT_ITGLUE_BASE_URL=
WAIT_ITGLUE_API_KEY=
WAIT_ITGLUE_PAGE_SIZE=25

# Confluence Cloud site URL, account email, API token, and bounded default page size.
WAIT_CONFLUENCE_BASE_URL=
WAIT_CONFLUENCE_EMAIL=
WAIT_CONFLUENCE_API_TOKEN=
WAIT_CONFLUENCE_PAGE_SIZE=25

# Microsoft Graph base URL, delegated or application bearer token, and bounded page size.
WAIT_SHAREPOINT_BASE_URL=https://graph.microsoft.com/v1.0
WAIT_SHAREPOINT_ACCESS_TOKEN=
WAIT_SHAREPOINT_PAGE_SIZE=25

# Microsoft Graph live identity reads; token acquisition remains external.
WAIT_M365_GRAPH_BASE_URL=https://graph.microsoft.com/v1.0
WAIT_M365_ACCESS_TOKEN=
WAIT_M365_PAGE_SIZE=25

# ServiceNow instance URL and basic-auth credentials for read-only Table API calls.
WAIT_SERVICENOW_BASE_URL=
WAIT_SERVICENOW_USERNAME=
WAIT_SERVICENOW_PASSWORD=

# Optional Table API version (for example v1) and bounded default page size.
WAIT_SERVICENOW_API_VERSION=
WAIT_SERVICENOW_PAGE_SIZE=25

# Autotask PSA read-only REST access.
WAIT_AUTOTASK_BASE_URL=
WAIT_AUTOTASK_USERNAME=
WAIT_AUTOTASK_SECRET=
WAIT_AUTOTASK_INTEGRATION_CODE=
WAIT_AUTOTASK_PAGE_SIZE=50

# NinjaOne Public API v2 RMM adapter. Use one explicit WAIT client to NinjaOne
# organization mapping per tenant; credentials never enter action payloads.
WAIT_NINJAONE_BASE_URL=https://app.ninjarmm.com/api/v2
WAIT_NINJAONE_ACCESS_TOKEN=
WAIT_NINJAONE_ORGANIZATION_MAP_JSON=
WAIT_NINJAONE_PAGE_SIZE=50

# Datto RMM API v2 read-only adapter. Map each WAIT client to one Datto site UID.
WAIT_DATTORMM_BASE_URL=https://your-datto-api-host/api
WAIT_DATTORMM_ACCESS_TOKEN=
WAIT_DATTORMM_SITE_MAP_JSON=
WAIT_DATTORMM_PAGE_SIZE=50

# N-able N-sight documented XML Data Extraction API read adapter. Map each WAIT
# client to one positive N-sight client ID; the provider API key is never sent
# in action payloads. The documented API requires the key in its query contract.
WAIT_NSIGHT_BASE_URL=https://your-n-sight-server
WAIT_NSIGHT_API_KEY=
WAIT_NSIGHT_CLIENT_MAP_JSON=

# TimeZest read-only scheduling-request API. Map each WAIT client to one
# documented Autotask or ConnectWise PSA company ID for tenant-scoped reads.
WAIT_TIMEZEST_BASE_URL=https://api.timezest.com
WAIT_TIMEZEST_API_KEY=
WAIT_TIMEZEST_CLIENT_MAP_JSON={"acme":{"connectwise_psa_company_id":209116}}

# Primary pack license key used to unlock licensed packs.
WAIT_LICENSE_KEY=

# Optional secondary license secret for pack-specific validation flows.
WAIT_LICENSE_SECRET=

# Shared secret used to verify signed pack tarball installs.
WAIT_PACK_SIGNING_SECRET=
